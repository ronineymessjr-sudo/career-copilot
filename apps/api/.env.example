CAREER_COPILOT_DB=./data/career_copilot.db
APPROVAL_FIRST=true

# Safe default: no external model request.
MODEL_PROVIDER=mock
MODEL_BASE_URL=http://127.0.0.1:11434
MODEL_NAME=qwen2.5:3b
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=45

# Ollama example:
# MODEL_PROVIDER=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434
# MODEL_NAME=qwen2.5:3b

# vLLM / OpenAI-compatible example:
# MODEL_PROVIDER=vllm
# MODEL_BASE_URL=http://127.0.0.1:8001
# MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# Data layer. SQLite is the safe local default. Set DATA_BACKEND=dual to sync
# verified records to Supabase while retaining a local recovery copy.
DATA_BACKEND=sqlite
SUPABASE_URL=
SUPABASE_KEY=
# Preferred: a signed-in user's access token so RLS is enforced.
SUPABASE_ACCESS_TOKEN=
SUPABASE_USER_ID=
SUPABASE_TIMEOUT_SECONDS=20

# Required for write-triggering admin endpoints such as sync, Git evidence,
# and external-model benchmarks. Never expose this value to the browser.
CAREER_COPILOT_ADMIN_TOKEN=
