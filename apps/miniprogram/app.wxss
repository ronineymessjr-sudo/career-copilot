page { background: #f4f7f4; color: #202622; font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
.page { min-height: 100vh; padding: 36rpx 32rpx 56rpx; box-sizing: border-box; }
.brand { display: flex; align-items: center; gap: 18rpx; color: #202622; font-size: 30rpx; font-weight: 700; letter-spacing: -0.02em; }
.brand-mark { display: grid; place-items: center; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #1d6a55; color: #fff; font-size: 28rpx; }
.muted { color: #6a756d; }
.button-primary { margin: 0; border-radius: 16rpx; background: #202622; color: #fff; font-size: 30rpx; line-height: 96rpx; }
.button-primary::after { border: 0; }
.button-secondary { margin: 0; border: 1px solid #c9d8ce; border-radius: 16rpx; background: #fff; color: #1d6a55; font-size: 28rpx; line-height: 88rpx; }
.button-secondary::after { border: 0; }
