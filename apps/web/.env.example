# Public Supabase values used by the browser and Route Handlers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Demo mode works without Supabase. Set production after database setup.
APP_MODE=demo

# Optional FastAPI fallback for engineering evidence pages.
CAREER_COPILOT_API_URL=

# Server-only Cloudflare secrets. Configure with `wrangler secret put`; never expose to the browser.
SUPABASE_SECRET_KEY=
OWNER_USER_ID=
CRON_SHARED_SECRET=

# Optional semantic retrieval. Without this key, knowledge search uses deterministic lexical fallback.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
