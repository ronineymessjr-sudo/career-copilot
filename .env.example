# ─────────────────────────────────────
# Career Copilot V2 — 环境变量模板
# 复制为 .env.local 并填入真实值
# ─────────────────────────────────────

# ── 运行模式 ──
# "production" 启用完整功能；"demo" 仅展示演示数据
APP_MODE=production

# ── Supabase ──
# 在 https://supabase.com 创建项目后获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── OpenAI ──
# 用于简历生成、JD 分析、语义搜索
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_FALLBACK_API_KEY=sk-xxxxxxxxxxxx
OPENAI_SEARCH_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Tavily（免费搜索）──
# 在 https://tavily.com 注册获取，用于岗位网页搜索
TAVILY_API_KEY=tvly-xxxxxxxxxxxx

# ── 用户与权限 ──
# 部署者自己的 Supabase Auth User ID（可在 Supabase Dashboard > Auth 查看）
OWNER_USER_ID=
# 管理员用户 ID 列表（逗号分隔，可选）
PLATFORM_ADMIN_USER_IDS=

# ── 定时任务密钥 ──
# Scheduler Worker 与 Web Worker 之间的共享密钥
CRON_SHARED_SECRET=generate-a-random-secret

# ── 加密密钥 ──
# 用于加密第三方平台凭证，32 字节随机字符串
INTEGRATION_ENCRYPTION_KEY=generate-32-byte-key

# ── Google OAuth（可选，邮件草稿功能）──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── API URL ──
# 备用 FastAPI 服务地址（可选）
CAREER_COPILOT_API_URL=http://localhost:8001
