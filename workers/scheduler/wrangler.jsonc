{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "career-copilot-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 0 * * *",
      "0 12 * * SUN"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "services": [
    {
      "binding": "WEB",
      "service": "career-copilot-v2"
    }
  ]
}
